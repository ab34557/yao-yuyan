  匠 取身份() 【
    抓("http://127.0.0.1:8795/api/我是谁") 归 响应
    判 取(响应, "码", 0) == 200 【
      真 ⇒ 【
        析(取(响应, "文", "{}")) 归 我
        取(我, "用户", {}) 归 用
        取(用, "名", "未知") 易 用户名
        取(用, "角色名", "访客") 易 角色名
      】
    】
    回 1
  】

  匠 取用户() 【
    抓("http://127.0.0.1:8795/api/用户") 归 响应
    判 取(响应, "码", 0) == 403 【
      真 ⇒ 【
        1 易 权限不足
        回 0
      】
    】
    判 取(响应, "码", 0) == 200 【
      真 ⇒ 【
        0 易 权限不足
        析(取(响应, "文", "[]")) 易 用户们
        长(用户们) 易 总用户
      】
    】
    回 1
  】

  匠 建用户() 【
    请求("http://127.0.0.1:8795/api/用户", { "法" ⇒ "POST", "体" ⇒ { "账号" ⇒ 新账号, "密码" ⇒ 新密码, "名" ⇒ 新名, "角色" ⇒ 新角色 } }) 归 响应
    取(响应, "码", 0) 归 码
    判 码 == 200 【
      真 ⇒ "已创建用户 " + 新账号 易 提示
      它 ⇒ 【
        析(取(响应, "文", "{}")) 归 错表
        "创建失败：" + 串(取(错表, "错", "")) 易 提示
      】
    】
    0 易 显示表单
    行 取用户()
    回 1
  】

  匠 改角色(账号, 角色) 【
    请求("http://127.0.0.1:8795/api/用户/" + 账号 + "/角色", { "法" ⇒ "POST", "体" ⇒ { "角色" ⇒ 角色 } }) 归 响应
    取(响应, "码", 0) 归 码
    判 码 == 200 【
      真 ⇒ 账号 + " 角色已改为 " + 角色 易 提示
      它 ⇒ 【
        析(取(响应, "文", "{}")) 归 错表2
        "改角色失败：" + 串(取(错表2, "错", "")) 易 提示
      】
    】
    行 取用户()
    回 1
  】

  匠 禁用(账号, 启用) 【
    请求("http://127.0.0.1:8795/api/用户/" + 账号 + "/启停", { "法" ⇒ "POST", "体" ⇒ { "启用" ⇒ 启用 } }) 归 响应
    取(响应, "码", 0) 归 码
    判 码 == 200 【
      真 ⇒ 判 启用 == 真 【 真 ⇒ 账号 + " 已启用" 易 提示 它 ⇒ 账号 + " 已禁用" 易 提示 】
      它 ⇒ 【
        析(取(响应, "文", "{}")) 归 错表3
        "操作失败：" + 串(取(错表3, "错", "")) 易 提示
      】
    】
    行 取用户()
    回 1
  】

  匠 删除(账号) 【
    请求("http://127.0.0.1:8795/api/用户/" + 账号 + "/删除", { "法" ⇒ "POST" }) 归 响应
    取(响应, "码", 0) 归 码
    判 码 == 200 【
      真 ⇒ 账号 + " 已删除" 易 提示
      它 ⇒ 【
        析(取(响应, "文", "{}")) 归 错表4
        "删除失败：" + 串(取(错表4, "错", "")) 易 提示
      】
    】
    行 取用户()
    回 1
  】

