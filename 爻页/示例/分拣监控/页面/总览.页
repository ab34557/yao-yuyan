  匠 取身份() 【
    抓("http://127.0.0.1:8795/api/我是谁") 归 响应
    判 取(响应, "码", 0) != 200 【
      真 ⇒ 回 0
    】
    析(取(响应, "文", "{}")) 归 我
    取(我, "用户", {}) 归 用
    取(用, "名", "未知") 易 用户名
    取(用, "角色名", "访客") 易 角色名
    回 1
  】

  匠 刷一次() 【
    抓("http://127.0.0.1:8795/api/快照") 归 响应
    取(响应, "码", 0) 归 码
    判 码 == 200 【
      真 ⇒ 【
        析(取(响应, "文", "{}")) 归 快
        取(快, "kpi", {}) 归 指标
        取(指标, "总到达", 0) 易 总到达
        取(指标, "大件", 0) 易 大件
        取(指标, "小件", 0) 易 小件
        取(指标, "超重", 0) 易 超重
        取(指标, "出货", 0) 易 出货
        取(指标, "识别率", 0) 易 识别率
        取(指标, "进料速度", 0) 易 进料速度
        取(快, "未确认告警", 0) 易 未确认
        取(快, "最后心跳", "") 易 心跳
        取(快, "趋势", []) 易 趋势
        判 取(快, "在线", 假) == 真 【
          真 ⇒ "● 设备在线" 易 连接态
          它 ⇒ "● 设备离线" 易 连接态
        】
        抓("http://127.0.0.1:8795/api/设备") 归 设备响应
        判 取(设备响应, "码", 0) == 200 【
          真 ⇒ 析(取(设备响应, "文", "[]")) 易 设备们
        】
      】
    】
    "● 后端未连接" 易 连接态
    回 1
  】

