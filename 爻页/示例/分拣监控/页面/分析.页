  匠 取身份() 【
    抓("http://127.0.0.1:8795/api/我是谁") 归 响应
    判 取(响应, "码", 0) == 200 【
      真 ⇒ 【
        析(取(响应, "文", "{}")) 归 我
        取(我, "用户", {}) 归 用
        取(用, "名", "未知") 易 用户名
        取(用, "角色名", "访客") 易 角色名
      】
    】
    回 1
  】

  匠 取分析() 【
    抓("http://127.0.0.1:8795/api/分析/总览") 归 响应
    判 取(响应, "码", 0) == 200 【
      真 ⇒ 【
        析(取(响应, "文", "{}")) 归 分析
        今() 易 刷新时间
        取(分析, "采样数", 0) 易 采样数

        取(分析, "oee", 空值) 归 o
        判 o != 空值 【
          真 ⇒ 【
            取(o, "oee", 0) 易 oee
            取(o, "可用率", 0) 易 可用率
            取(o, "性能率", 0) 易 性能率
            取(o, "质量率", 0) 易 质量率
          】
        】

        取(分析, "节拍", 空值) 归 节
        判 节 != 空值 【
          真 ⇒ 【
            取(节, "每件秒", 0) 易 每件秒
            取(节, "每小时件", 0) 易 每小时件
          】
        】

        取(分析, "质量", 空值) 归 质
        判 质 != 空值 【
          真 ⇒ 【
            取(质, "超重率", 0) 易 超重率
            取(质, "大件占比", 0) 易 大件占比
            取(质, "小件占比", 0) 易 小件占比
          】
        】

        取(分析, "故障分析", 空值) 归 故
        判 故 != 空值 【
          真 ⇒ 【
            取(故, "总告警", 0) 易 总告警
            取(故, "未确认", 0) 易 未确认告警
            取(故, "按位号", []) 易 位号榜
            取(故, "高频故障", []) 易 高频故障
          】
        】

        取(分析, "产量趋势", []) 易 产量趋势
        取(分析, "设备排行", []) 易 设备排行
      】
    】
    回 1
  】

