      钮 "分析" 点 【 跳 "分析.页" 】 底 "#1e293b" 色 "#cbd5e1" 圆 6 大 10
      钮 "告警" 点 【 跳 "告警.页" 】 底 "#1e293b" 色 "#cbd5e1" 圆 6 大 10
      钮 "物联" 点 【 跳 "物联.页" 】 底 "#1e293b" 色 "#cbd5e1" 圆 6 大 10
      钮 "用户" 点 【 跳 "用户.页" 】 底 "#1e293b" 色 "#cbd5e1" 圆 6 大 10
      钮 "参数" 点 【 跳 "参数.页" 】 底 "#1e293b" 色 "#cbd5e1" 圆 6 大 10
