  匠 取身份() 【
    抓("http://127.0.0.1:8795/api/我是谁") 归 响应
    判 取(响应, "码", 0) == 200 【
      真 ⇒ 【
        析(取(响应, "文", "{}")) 归 我
        取(我, "用户", {}) 归 用
        取(用, "名", "未知") 易 用户名
        取(用, "角色名", "访客") 易 角色名
      】
    】
    回 1
  】

  匠 取状态() 【
    抓("http://127.0.0.1:8795/api/物联/状态") 归 响应
    判 取(响应, "码", 0) == 403 【
      真 ⇒ 【
        1 易 权限不足
        回 0
      】
    】
    判 取(响应, "码", 0) == 200 【
      真 ⇒ 【
        0 易 权限不足
        析(取(响应, "文", "{}")) 归 概
        取(概, "MQTT", {}) 归 m
        取(m, "状态", "未知") 易 MQTT状态
        取(概, "Modbus", {}) 归 mm
        取(mm, "状态", "未知") 易 Modbus状态
        取(概, "采集", {}) 归 c
        取(c, "状态", "未知") 易 采集状态
        取(概, "采集线程号", 0) 易 采集线程号
        取(概, "启动时间", "") 易 启动时间
        取(概, "配置", {}) 归 配
        串(取(配, "mqtt主机", "")) 易 mqtt主机
        串(取(配, "mqtt端口", "")) 易 mqtt端口
        串(取(配, "mqtt主题", "")) 易 mqtt主题
        串(取(配, "modbus主机", "")) 易 modbus主机
        串(取(配, "modbus端口", "")) 易 modbus端口
        串(取(配, "modbus从站", "")) 易 modbus从站
        串(取(配, "采集间隔秒", "")) 易 采集间隔秒
      】
    】
    回 1
  】

  匠 启服务() 【
    请求("http://127.0.0.1:8795/api/物联/启动", { "法" ⇒ "POST" }) 归 响应
    取(响应, "码", 0) 归 码
    判 码 == 200 【
      真 ⇒ 【
        析(取(响应, "文", "{}")) 归 果
        "服务已启动：" + 串(取(果, "说明", "")) 易 提示
      】
      它 ⇒ "启动失败（码 " + 串(码) + "）" 易 提示
    】
    行 取状态()
    回 1
  】

  匠 停服务() 【
    请求("http://127.0.0.1:8795/api/物联/停止", { "法" ⇒ "POST" }) 归 响应
    取(响应, "码", 0) 归 码
    判 码 == 200 【
      真 ⇒ 【
        析(取(响应, "文", "{}")) 归 果
        "服务已停止：" + 串(取(果, "说明", "")) 易 提示
      】
      它 ⇒ "停止失败（码 " + 串(码) + "）" 易 提示
    】
    行 取状态()
    回 1
  】

  匠 重服务() 【
    请求("http://127.0.0.1:8795/api/物联/重启", { "法" ⇒ "POST" }) 归 响应
    取(响应, "码", 0) 归 码
    判 码 == 200 【
      真 ⇒ "服务已重启" 易 提示
      它 ⇒ "重启失败（码 " + 串(码) + "）" 易 提示
    】
    行 取状态()
    回 1
  】

  匠 存配置() 【
    请求("http://127.0.0.1:8795/api/物联/配置", { "法" ⇒ "POST", "体" ⇒ { "mqtt主机" ⇒ mqtt主机, "mqtt端口" ⇒ 数(mqtt端口), "mqtt主题" ⇒ mqtt主题, "modbus主机" ⇒ modbus主机, "modbus端口" ⇒ 数(modbus端口), "modbus从站" ⇒ 数(modbus从站), "采集间隔秒" ⇒ 数(采集间隔秒) } }) 归 响应
    取(响应, "码", 0) 归 码
    判 码 == 200 【
      真 ⇒ "配置已保存（重启服务后生效）" 易 提示
      它 ⇒ "保存失败（码 " + 串(码) + "）" 易 提示
    】
    行 取状态()
    回 1
  】

  匠 测MQTT() 【
    请求("http://127.0.0.1:8795/api/物联/测MQTT", { "法" ⇒ "POST" }) 归 响应
    析(取(响应, "文", "{}")) 归 果
    判 取(果, "成", 假) == 真 【
      真 ⇒ "✓ MQTT：" + 串(取(果, "说明", "")) 易 测试结果
      它 ⇒ "✗ MQTT：" + 串(取(果, "错", "")) 易 测试结果
    】
    回 1
  】

  匠 测Modbus() 【
    请求("http://127.0.0.1:8795/api/物联/测Modbus", { "法" ⇒ "POST" }) 归 响应
    析(取(响应, "文", "{}")) 归 果
