注 ============================================================
注 爻语论坛 —— 后端全部由爻语（.yao）编写
注 前端全部由爻页（.页）编写，由爻页浏览器（tkinter）渲染
注 两边都不使用 HTML / CSS / JavaScript
注 运行：python -X utf8 -m yao 跑 examples\论坛\主.yao
注 打开：python -X utf8 -m 爻页 examples\论坛\页面\首页.页
注 ============================================================

"爻语/示例/论坛/数据/论坛.json" 名 库路径
"admin" 名 默认管理员
"admin12345" 名 默认密码

注 ============ 一、存储 ============

匠 空库() 【
  归 {
    "用户" ⇒ [],
    "会话" ⇒ {},
    "版块" ⇒ [
      { "号" ⇒ 1, "名" ⇒ "聊天", "说明" ⇒ "随便聊聊，什么都可以" },
      { "号" ⇒ 2, "名" ⇒ "技术", "说明" ⇒ "编程、工具、折腾" },
      { "号" ⇒ 3, "名" ⇒ "语言", "说明" ⇒ "爻语与爻页的设计与实现" },
      { "号" ⇒ 4, "名" ⇒ "公告", "说明" ⇒ "站点通知" }
    ],
    "贴" ⇒ [],
    "回" ⇒ [],
    "序号" ⇒ { "用户" ⇒ 0, "贴" ⇒ 0, "回" ⇒ 0 }
  }
】

匠 读库() 【
  判 【 在(库路径) == 假 ⇒ 归 空库() 它 ⇒ 空 】
  试 【
    析(读(库路径)) 名 库
    判 【
      型(库) != "表" ⇒ 归 空库()
      含(库, "用户") == 假 ⇒ 归 空库()
      含(库, "贴") == 假 ⇒ 归 空库()
      它 ⇒ 归 库
    】
  】 捕 误 【
    归 空库()
  】
】

匠 写库(库) 【
  写(库路径, 构(库))
  归 空
】

注 ============ 二、账号 ============

匠 找用户(库, 用户名字) 【
  0 名 位
  遍 用 于 库["用户"] 【
    判 【 用["名"] == 用户名字 ⇒ 归 位 它 ⇒ 空 】
    位 + 1 易 位
  】
  归 -1
】

匠 校验名(用户名字) 【
  判 【 型(用户名字) != "字" ⇒ 归 "名字必须是字" 它 ⇒ 空 】
  裁(用户名字) 名 净
  判 【 长(净) < 2 ⇒ 归 "名字至少 2 个字" 它 ⇒ 空 】
  判 【 长(净) > 16 ⇒ 归 "名字最多 16 个字" 它 ⇒ 空 】
  归 ""
】

匠 注册用户(库, 用户名字, 密码) 【
  校验名(用户名字) 名 错
  判 【 错 != "" ⇒ 归 { "成" ⇒ 假, "说明" ⇒ 错 } 它 ⇒ 空 】
  判 【 长(密码) < 6 ⇒ 归 { "成" ⇒ 假, "说明" ⇒ "密码至少 6 位" } 它 ⇒ 空 】
  裁(用户名字) 名 净
  判 【 找用户(库, 净) >= 0 ⇒ 归 { "成" ⇒ 假, "说明" ⇒ "这个名字已经被注册" } 它 ⇒ 空 】

  随机字(16) 名 盐
  库["序号"]["用户"] + 1 易 库["序号"]["用户"]
  {
    "号" ⇒ 库["序号"]["用户"],
    "名" ⇒ 净,
    "盐" ⇒ 盐,
    "摘要" ⇒ 散列(密码, 盐),
    "注册" ⇒ 今(),
    "贴数" ⇒ 0
  } 名 用
  增(库["用户"], 用)
  写库(库)
  归 { "成" ⇒ 真, "说明" ⇒ "注册成功", "用户" ⇒ 去密(用) }
】

匠 去密(用) 【
  归 { "号" ⇒ 用["号"], "名" ⇒ 用["名"], "注册" ⇒ 用["注册"], "贴数" ⇒ 用["贴数"] }
】

匠 登录用户(库, 用户名字, 密码) 【
  裁(用户名字) 名 净
  找用户(库, 净) 名 位
  判 【 位 < 0 ⇒ 归 { "成" ⇒ 假, "说明" ⇒ "名字或密码不对" } 它 ⇒ 空 】
  库["用户"][位] 名 用
  判 【
    恒等(散列(密码, 用["盐"]), 用["摘要"]) ⇒ 空
    它 ⇒ 归 { "成" ⇒ 假, "说明" ⇒ "名字或密码不对" }
  】
  随机字(32) 名 令牌
  { "用户名" ⇒ 用["名"], "建立" ⇒ 今() } 名 会话
  会话 易 库["会话"][令牌]
  写库(库)
  归 { "成" ⇒ 真, "说明" ⇒ "登录成功", "令牌" ⇒ 令牌, "用户" ⇒ 去密(用) }
】

匠 当前人(库, 令牌) 【
  判 【 含(库["会话"], 令牌) == 假 ⇒ 归 空 它 ⇒ 空 】
  库["会话"][令牌]["用户名"] 名 会话人
  找用户(库, 会话人) 名 位
  判 【 位 < 0 ⇒ 归 空 它 ⇒ 归 库["用户"][位] 】
】

注 ============ 三、贴子与回复 ============

匠 版块名(库, 号) 【
  遍 版 于 库["版块"] 【
    判 【 版["号"] == 号 ⇒ 归 版["名"] 它 ⇒ 空 】
  】
  归 "未知版块"
】

匠 发贴(库, 用户, 版号, 标题, 正文) 【
  判 【 型(标题) != "字" 或 裁(标题) == "" ⇒ 归 { "成" ⇒ 假, "说明" ⇒ "标题不能为空" } 它 ⇒ 空 】
  判 【 长(标题) > 60 ⇒ 归 { "成" ⇒ 假, "说明" ⇒ "标题最多 60 字" } 它 ⇒ 空 】
  判 【 型(正文) != "字" 或 裁(正文) == "" ⇒ 归 { "成" ⇒ 假, "说明" ⇒ "正文不能为空" } 它 ⇒ 空 】
  判 【 长(正文) > 5000 ⇒ 归 { "成" ⇒ 假, "说明" ⇒ "正文最多 5000 字" } 它 ⇒ 空 】
  判 【 版号 < 1 或 版号 > 4 ⇒ 归 { "成" ⇒ 假, "说明" ⇒ "版块不存在" } 它 ⇒ 空 】

  库["序号"]["贴"] + 1 易 库["序号"]["贴"]
  {
    "号" ⇒ 库["序号"]["贴"],
    "版" ⇒ 版号,
    "标题" ⇒ 裁(标题),
    "正文" ⇒ 裁(正文),
    "作者" ⇒ 用户["名"],
    "时间" ⇒ 今(),
    "回复数" ⇒ 0,
    "最后回复" ⇒ 今()
  } 名 贴
  增(库["贴"], 贴)
  用户["贴数"] + 1 易 用户["贴数"]
  写库(库)
  归 { "成" ⇒ 真, "说明" ⇒ "发布成功", "贴" ⇒ 贴 }
】

匠 找贴(库, 号) 【
  遍 贴 于 库["贴"] 【
    判 【 贴["号"] == 号 ⇒ 归 贴 它 ⇒ 空 】
  】
  归 空
】

匠 回复贴(库, 用户, 贴号, 正文) 【
  判 【 型(正文) != "字" 或 裁(正文) == "" ⇒ 归 { "成" ⇒ 假, "说明" ⇒ "回复不能为空" } 它 ⇒ 空 】
  判 【 长(正文) > 2000 ⇒ 归 { "成" ⇒ 假, "说明" ⇒ "回复最多 2000 字" } 它 ⇒ 空 】
  找贴(库, 贴号) 名 贴
  判 【 贴 == 空 ⇒ 归 { "成" ⇒ 假, "说明" ⇒ "贴子不存在" } 它 ⇒ 空 】

  库["序号"]["回"] + 1 易 库["序号"]["回"]
  {
    "号" ⇒ 库["序号"]["回"],
    "贴号" ⇒ 贴号,
    "作者" ⇒ 用户["名"],
    "正文" ⇒ 裁(正文),
    "时间" ⇒ 今()
  } 名 回
  增(库["回"], 回)
  贴["回复数"] + 1 易 贴["回复数"]
  今() 易 贴["最后回复"]
  写库(库)
  归 { "成" ⇒ 真, "说明" ⇒ "回复成功", "回复" ⇒ 回 }
】

匠 取回复(库, 贴号) 【
  [] 名 结果列
  遍 回 于 库["回"] 【
    判 【 回["贴号"] == 贴号 ⇒ 增(结果列, 回) 它 ⇒ 空 】
  】
  归 结果列
】

注 贴子列表：可按版块过滤，按最后活动倒序
匠 取贴们(库, 版号) 【
  [] 名 结果列
  遍 贴 于 库["贴"] 【
    判 【
      版号 == 0 ⇒ 增(结果列, 贴)
      贴["版"] == 版号 ⇒ 增(结果列, 贴)
      它 ⇒ 空
    】
  】
  注 最近活动的在前：按号倒序近似
  排(结果列, 节 (贴) 【 归 0 - 贴["号"] 】) 名 倒序
  归 倒序
】

匠 统计(库) 【
  0 名 回复总
  遍 回 于 库["回"] 【 回复总 + 1 易 回复总 】
  归 {
    "用户数" ⇒ 长(库["用户"]),
    "贴数" ⇒ 长(库["贴"]),
    "回复数" ⇒ 回复总,
    "版块数" ⇒ 长(库["版块"])
  }
】

注 ============ 四、HTTP 接口 ============

匠 取令牌(请) 【
  取(请.头, "x-token", "") 名 头值
  判 【 头值 != "" ⇒ 归 头值 它 ⇒ 归 取(请.参, "令牌", "") 】
】

匠 需要(库, 请) 【
  当前人(库, 取令牌(请)) 名 人
  判 【
    人 == 空 ⇒ 归 应(401, { "Content-Type" ⇒ "application/json; charset=utf-8" }, { "错" ⇒ "请先登录" })
    它 ⇒ 归 空
  】
】

路("GET", "/api/健康", 节 (请) 【
  读库() 名 库
  归 { "行" ⇒ 真, "版本" ⇒ 版本(), "时间" ⇒ 今(), "统计" ⇒ 统计(库) }
】)

路("POST", "/api/注册", 节 (请) 【
  读库() 名 库
  注册用户(库, 取(请.体, "名", ""), 取(请.体, "密码", "")) 名 果
  判 【
    果["成"] ⇒ 归 应(201, { "Content-Type" ⇒ "application/json; charset=utf-8" }, 果)
    它 ⇒ 归 应(400, { "Content-Type" ⇒ "application/json; charset=utf-8" }, 果)
  】
】)

路("POST", "/api/登录", 节 (请) 【
  读库() 名 库
  登录用户(库, 取(请.体, "名", ""), 取(请.体, "密码", "")) 名 果
  判 【
    果["成"] ⇒ 归 果
    它 ⇒ 归 应(401, { "Content-Type" ⇒ "application/json; charset=utf-8" }, 果)
  】
】)

路("GET", "/api/我", 节 (请) 【
  读库() 名 库
  当前人(库, 取令牌(请)) 名 人
  判 【
    人 == 空 ⇒ 归 应(401, { "Content-Type" ⇒ "application/json; charset=utf-8" }, { "错" ⇒ "未登录" })
    它 ⇒ 归 去密(人)
  】
】)

路("GET", "/api/版块", 节 (请) 【
  读库() 名 库
  归 库["版块"]
】)

路("GET", "/api/贴", 节 (请) 【
  读库() 名 库
  取贴们(库, 数(取(请.参, "版", "0"))) 名 贴们
  判 【
    取(请.参, "取", "") == "标题" ⇒ 归 贴们
    它 ⇒ 归 贴们
  】
】)

路("GET", "/api/贴/:号", 节 (请) 【
  读库() 名 库
  找贴(库, 数(请.参["号"])) 名 贴
  判 【
    贴 == 空 ⇒ 归 应(404, { "Content-Type" ⇒ "application/json; charset=utf-8" }, { "错" ⇒ "贴子不存在" })
    它 ⇒ 空
  】
  归 {
    "贴" ⇒ 贴,
    "版块" ⇒ 版块名(库, 贴["版"]),
    "回复" ⇒ 取回复(库, 贴["号"])
  }
】)

路("POST", "/api/发贴", 节 (请) 【
  读库() 名 库
  需要(库, 请) 名 拦
  判 【 拦 != 空 ⇒ 归 拦 它 ⇒ 空 】
  当前人(库, 取令牌(请)) 名 人
  发贴(
    库, 人,
    数(取(请.体, "版", 1)),
    取(请.体, "标题", ""),
    取(请.体, "正文", "")
  ) 名 果
  判 【
    果["成"] ⇒ 归 应(201, { "Content-Type" ⇒ "application/json; charset=utf-8" }, 果)
    它 ⇒ 归 应(400, { "Content-Type" ⇒ "application/json; charset=utf-8" }, 果)
  】
】)

路("POST", "/api/回复", 节 (请) 【
  读库() 名 库
  需要(库, 请) 名 拦
  判 【 拦 != 空 ⇒ 归 拦 它 ⇒ 空 】
  当前人(库, 取令牌(请)) 名 人
  回复贴(库, 人, 数(取(请.体, "贴号", 0)), 取(请.体, "正文", "")) 名 果
  判 【
    果["成"] ⇒ 归 应(201, { "Content-Type" ⇒ "application/json; charset=utf-8" }, 果)
    它 ⇒ 归 应(400, { "Content-Type" ⇒ "application/json; charset=utf-8" }, 果)
  】
】)

路("GET", "/api/统计", 节 (请) 【
  读库() 名 库
  归 统计(库)
】)

注 首次启动建管理员 + 演示数据
匠 初始化() 【
  读库() 名 库
  判 【
    长(库["用户"]) == 0 ⇒ 【
      注册用户(库, 默认管理员, 默认密码) 名 果
      注册用户(库, "爻语新手", "newbie123") 名 果二
      发贴(库, 库["用户"][0], 3, "欢迎来到爻语论坛", "这个论坛的后端用爻语写，前端用爻页写，两边都没有用 HTML/CSS/JS。") 名 贴一
      发贴(库, 库["用户"][1], 1, "大家好，我是新来的", "第一次用爻页写界面，感觉很有意思。") 名 贴二
      发贴(库, 库["用户"][0], 4, "论坛规则", "友善交流，不要水贴。") 名 贴三
      回复贴(库, 库["用户"][1], 1, "支持！界面很清爽。") 名 回一
      回复贴(库, 库["用户"][0], 1, "谢谢，爻页的布局引擎还在完善。") 名 回二
      回复贴(库, 库["用户"][1], 2, "有什么上手指南吗？") 名 回三
    】
    它 ⇒ 空
  】
  归 空
】

初始化()

共 "爻语/示例/论坛/页面"
听 8793
